# Everything here is optional for local development.

# Postgres connection string (e.g. Neon). Without it, an embedded database in .data/ is used.
DATABASE_URL=

# Timezone used when the settings row is first created.
DEFAULT_TIMEZONE=America/New_York

# --- Google sign-in and Calendar sync ---
# Create an OAuth client (type "Web application") in Google Cloud Console with the
# Google Calendar API enabled. Authorised redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Random string used to sign the session cookie: `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=
# The only Google account allowed to sign in.
ALLOWED_EMAIL=
# Public https address of the deployment. Needed for instant updates from Google (push notifications).
# On Vercel this is detected automatically.
APP_URL=
# Protects the daily sync endpoint. Vercel sends it automatically when set as an env var.
CRON_SECRET=

# Local development only: skip sign-in even when Google is configured.
# AUTH_DISABLED=true

# --- AI assistant ---
# Anthropic API key. Without it the assistant panel is disabled; everything else works.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5).
# ANTHROPIC_MODEL=
